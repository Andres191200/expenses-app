datasource db {
  provider = "postgresql" // o "mysql" | "sqlite" | "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Expense {
  id    Int    @id @default(autoincrement())
  title  String
  category String @default("Misc")
  value Int
  createdAt DateTime @default(now())
}
